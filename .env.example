# 복사해서 .env 로 저장 후 값 채우기
SECRET_KEY=change-me-random-hex
# 배포 도메인 (sitemap/canonical/OG). 예: https://seohapnd.co.kr
SITE_URL=
# 관리자 (/admin BasicAuth)
ADMIN_ID=
ADMIN_PW=
# 문의 DB 경로 (기본: 프로젝트 폴더의 inquiries.db)
DB_PATH=
# 새 문의 알림 메일 (전부 비우면 알림 없음)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PW=
NOTIFY_TO=
